# Test environment — point at a NEON BRANCH, never your main database.
#
# Copy this file to .env.test (gitignored) and fill in your test branch's
# connection strings. The integration (db-ownership) and acceptance (Playwright)
# suites WRITE AND DELETE data, so they must run against a throwaway branch.
#
#   npm run test:integration   # loads .env.test
#   npm run test:acceptance    # loads .env.test, spawns `next dev` against it

# Neon test-branch connection strings (pooled for runtime, direct for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js — reuse the same AUTH_SECRET value as your .env (any 32-byte base64
# string; generate with: openssl rand -base64 32). Required for the acceptance
# test's dev sign-in flow.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Note: the acceptance script forces AUTH_DEV_ENABLED=1 and
# TEXTLAB_ASSISTANT_DISABLE_LIVE=1 in the Next process it spawns, so you do not
# need to set those here.
