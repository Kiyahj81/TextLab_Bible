# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/textlab_bible?schema=public"

# OpenAI assistant
# Leave OPENAI_API_KEY empty to use the local-retrieval fallback (no live model call).
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-5.3-chat-latest"
OPENAI_SCHOLARLY_MODEL="gpt-5.4"
# Set to "1" to force the local fallback even when OPENAI_API_KEY is set.
TEXTLAB_ASSISTANT_DISABLE_LIVE="0"
OPENAI_REQUEST_TIMEOUT_MS="25000"
# Output-token cap on assistant responses; bounds the cost of any single call.
OPENAI_MAX_OUTPUT_TOKENS="1200"

# Auth.js v5
# Required in every environment; generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the deployed app (e.g. http://localhost:3000 or https://example.com).
# Auth.js reads this for OAuth redirect URIs.
AUTH_URL="http://localhost:3000"

# GitHub OAuth provider (production). When both values are set, the GitHub
# provider is enabled. Leave empty in local dev unless you have credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Dev-only credentials provider. Set AUTH_DEV_ENABLED=1 in local dev to enable
# the "Dev login" sign-in form (no password — sign in as any email). NEVER set
# this in production.
AUTH_DEV_ENABLED="0"
