{
  "name": "textlab-bible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:acceptance": "node scripts/acceptance-test.js",
    "test:unit": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
