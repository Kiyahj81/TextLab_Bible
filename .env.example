# Database
# Neon (serverless Postgres). DATABASE_URL is the POOLED string (host contains
# "-pooler"); DIRECT_URL is the direct/unpooled string used for migrations.
# Both must keep the "?sslmode=require" parameter Neon provides.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/textlab_bible?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/textlab_bible?sslmode=require"
# Local Docker fallback (offline dev): point both at localhost and drop sslmode.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/textlab_bible?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/textlab_bible?schema=public"

# OpenAI assistant
# Leave OPENAI_API_KEY empty to use the local-retrieval fallback (no live model call).
OPENAI_API_KEY=""
# Default model must accept a `temperature` param (gpt-5.3-chat-latest rejects it).
OPENAI_DEFAULT_MODEL="gpt-5-chat-latest"
OPENAI_SCHOLARLY_MODEL="gpt-5.4"
# Set to "1" to force the local fallback even when OPENAI_API_KEY is set.
TEXTLAB_ASSISTANT_DISABLE_LIVE="0"
# Client wait before giving up; must exceed how long a full answer takes to
# generate or completed responses are abandoned to the local fallback.
OPENAI_REQUEST_TIMEOUT_MS="120000"
# Output-token cap on assistant responses; bounds the cost of any single call.
OPENAI_MAX_OUTPUT_TOKENS="2400"
# Synthesis sampling temperature (0–2); lower curbs sampling noise / language leaks.
OPENAI_TEMPERATURE="0.3"

# --- Phase 4b: semantic rerank (optional) ---
# Vercel AI Gateway key. Its PRESENCE enables Voyage reranking of the assistant's
# semantic candidate pool. Unset → searchSemantic falls back to RRF order (no behavior change).
# The Voyage API key itself lives in AI Gateway settings (BYOK) or Vercel credits — not here.
AI_GATEWAY_API_KEY=
# Optional rerank model override (default: voyage/rerank-2.5).
RERANK_MODEL=voyage/rerank-2.5
# Optional rerank timeout in ms (default: 3000).
RERANK_TIMEOUT_MS=3000

# Auth.js v5
# Required in every environment; generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the deployed app (e.g. http://localhost:3000 or https://example.com).
# Auth.js reads this for OAuth redirect URIs.
AUTH_URL="http://localhost:3000"

# GitHub OAuth provider (production). When both values are set, the GitHub
# provider is enabled. Leave empty in local dev unless you have credentials.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Dev-only credentials provider. Set AUTH_DEV_ENABLED=1 in local dev to enable
# the "Dev login" sign-in form (no password — sign in as any email). NEVER set
# this in production.
AUTH_DEV_ENABLED="0"
