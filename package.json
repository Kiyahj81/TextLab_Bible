{
  "name": "textlab-bible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:acceptance": "node --env-file=.env.test scripts/acceptance-test.js",
    "test:unit": "vitest run",
    "test:integration": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npx tsc --noEmit --pretty false && npm run build && npm run test:coverage",
    "security:audit": "npm audit --audit-level=low",
    "db:push": "node -e \"console.error('db:push is disabled for this project; use npm run db:migrate:deploy so handwritten SQL migrations run.'); process.exit(1)\"",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "import:open-bible": "tsx --env-file=.env scripts/import-open-bible.ts",
    "import:macula-glosses": "tsx --env-file=.env scripts/import-open-bible.ts --macula-greek-url https://raw.githubusercontent.com/Clear-Bible/macula-greek/main/SBLGNT/tsv/macula-greek-SBLGNT.tsv",
    "import:louw-nida": "tsx --env-file=.env scripts/import-louw-nida.ts",
    "embed:verses": "tsx --env-file=.env scripts/embed-verses.ts",
    "eval:gate": "tsx --env-file=.env.test scripts/eval-gate.ts",
    "eval:report": "tsx --env-file=.env.test scripts/eval-report.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.7.0",
    "ai": "^6.0.196",
    "lucide-react": "^0.468.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
